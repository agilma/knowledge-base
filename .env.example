# Connection string PostgreSQL (Neon)
DATABASE_URL=

# Autentikasi Auth.js / NextAuth
AUTH_SECRET= # Secret key untuk enkripsi sesi (dapat dihasilkan via `npx auth secret`)
AUTH_GOOGLE_ID= # Client ID Google OAuth dari Google Cloud Console
AUTH_GOOGLE_SECRET= # Client Secret Google OAuth dari Google Cloud Console
AUTH_ALLOWED_DOMAIN=thunderlab.id # Domain email yang diizinkan untuk login
AUTH_ALLOWED_EMAILS= # Daftar email khusus di luar domain yang diizinkan (dipisah koma)
AUTH_ADMIN_EMAILS= # Daftar email yang otomatis mendapatkan role ADMIN saat login (dipisah koma)
ANTHROPIC_API_KEY= # Opsional. Kunci API Anthropic untuk Asisten AI di form dokumen (hanya admin)
