datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  VIEWER
  EDITOR
  ADMIN
}

enum DocumentType {
  PANDUAN
  MASALAH
  REFERENSI
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CollectionStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(VIEWER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  documents Document[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Collection {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  icon        String?
  status      CollectionStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  documents Document[]

  @@map("collections")
}

model Document {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  excerpt      String?
  content      String
  type         DocumentType   @default(PANDUAN)
  status       DocumentStatus @default(DRAFT)
  collectionId String
  authorId     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  collection  Collection         @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  author      User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  relatedFrom DocumentRelation[] @relation("RelatedFrom")
  relatedTo   DocumentRelation[] @relation("RelatedTo")

  @@index([collectionId])
  @@index([status])
  @@index([type])
  @@map("documents")
}

model DocumentRelation {
  fromId    String
  toId      String
  createdAt DateTime @default(now())

  from Document @relation("RelatedFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Document @relation("RelatedTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@map("document_relations")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@map("favorites")
}

model RecentView {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  viewedAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, viewedAt])
  @@map("recent_views")
}
