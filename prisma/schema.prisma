datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  VIEWER
  EDITOR
  ADMIN
}

enum DocumentType {
  PANDUAN
  MASALAH
  REFERENSI
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CollectionStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(VIEWER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  documents        Document[]         @relation("DocumentAuthor")
  editedDocuments  Document[]         @relation("DocumentEditor")
  revisions        DocumentRevision[]
  collectionAccess CollectionMember[]
  documentAccess   DocumentMember[]
  groups           GroupMember[]
  aiConversations  AiConversation[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Collection {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  icon        String?
  status      CollectionStatus @default(ACTIVE)
  // When true only admins and the users in `members` can read it.
  restricted  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  documents Document[]
  members   CollectionMember[]
  groups    CollectionGroup[]

  @@map("collections")
}

/// Who may read (and, for editors, write in) a restricted collection.
model CollectionMember {
  collectionId String
  userId       String
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([collectionId, userId])
  @@index([userId])
  @@map("collection_members")
}

model Document {
  id             String                   @id @default(cuid())
  slug           String                   @unique
  title          String
  excerpt        String?
  content        String
  type           DocumentType             @default(PANDUAN)
  status         DocumentStatus           @default(DRAFT)
  collectionId   String
  authorId       String?
  // Who saved the document last. Null until the first save after this existed.
  lastEditedById String?
  // When true only admins and the users in `members` can read it (and the collection must allow them too).
  restricted     Boolean                  @default(false)
  // The page this one sits under (a chapter under its guide); null for a top-level document.
  // Always in the same collection; set only through setDocumentParent (migration 13).
  parentId       String?
  // Order among the pages under the same parent: lowest first, then by title.
  position       Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  // Generated by the database from title, excerpt and content (migration 9); never
  // written from here. Search reads it instead of recomputing the vector per row.
  searchVector   Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('indonesian'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('indonesian'::regconfig, COALESCE(excerpt, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('indonesian'::regconfig, \"left\"(content, 200000)), 'C'::\"char\"))")) @map("search_vector")

  collection      Collection         @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  author          User?              @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lastEditedBy    User?              @relation("DocumentEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  relatedFrom     DocumentRelation[] @relation("RelatedFrom")
  relatedTo       DocumentRelation[] @relation("RelatedTo")
  revisions       DocumentRevision[]
  members         DocumentMember[]
  groups          DocumentGroup[]
  aiConversations AiConversation[]
  parent          Document?          @relation("DocumentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Document[]         @relation("DocumentTree")

  @@index([collectionId])
  @@index([parentId])
  @@index([status])
  @@index([type])
  @@index([searchVector], type: Gin, map: "documents_search_vector_idx")
  @@index([updatedAt(sort: Desc)])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "documents_title_trgm_idx")
  @@map("documents")
}

/// Who may read (and, for editors, write) a restricted document.
model DocumentMember {
  documentId String
  userId     String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@index([userId])
  @@map("document_members")
}

/// One saved state of a document, newest version highest. Written on every
/// save that changes the text; kept to the latest REVISION_LIMIT per document.
model DocumentRevision {
  id         String         @id @default(cuid())
  documentId String
  version    Int
  title      String
  excerpt    String?
  content    String
  type       DocumentType
  status     DocumentStatus
  editedById String?
  createdAt  DateTime       @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  editedBy User?    @relation(fields: [editedById], references: [id], onDelete: SetNull)

  @@unique([documentId, version])
  @@index([editedById])
  @@map("document_revisions")
}

model DocumentRelation {
  fromId    String
  toId      String
  createdAt DateTime @default(now())

  from Document @relation("RelatedFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Document @relation("RelatedTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@map("document_relations")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@map("favorites")
}

model RecentView {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  viewedAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, viewedAt])
  @@map("recent_views")
}

/// An email an admin has let in, with the role it gets on first sign-in. It works
/// next to AUTH_ALLOWED_DOMAIN / AUTH_ALLOWED_EMAILS and is removed to withdraw access.
model Invitation {
  id          String   @id @default(cuid())
  email       String   @unique
  role        Role     @default(VIEWER)
  invitedById String?
  createdAt   DateTime @default(now())

  @@map("invitations")
}

/// A saved chat with one of the AI assistants. Private to its owner: every query
/// carries the user id (src/lib/services/ai-conversations.ts) and nobody else,
/// admins included, can open it. Rows older than the retention period are deleted.
model AiConversation {
  id         String   @id @default(cuid())
  userId     String
  /// Which AI it is a chat with ("document"); each assistant keeps its own list.
  assistant  String
  title      String
  /// The document being edited when the chat began, only as context for the list.
  documentId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  messages AiMessage[]

  @@index([userId, assistant, updatedAt])
  @@index([updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  /// Position in the conversation, from 1; unique so two writers cannot both take the same slot.
  seq            Int
  /// "user" or "assistant".
  role           String
  content        String
  /// A document the assistant proposed, as the card showed it.
  proposal       Json?
  warnings       Json?
  error          String?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@map("ai_messages")
}

/// What people searched for and found nothing, counted per normalised phrase. No user is
/// recorded, only the phrase, so the list shows which topics are missing without showing who
/// asked. Rows are removed when dismissed, after 180 days, or beyond a fixed number.
model SearchMiss {
  query   String   @id
  count   Int      @default(1)
  firstAt DateTime @default(now())
  lastAt  DateTime @default(now())

  @@index([lastAt])
  @@map("search_misses")
}

/// A deleted document waiting in the trash (30 days): the whole document, with its versions,
/// members and links, as one JSON snapshot. No relations on purpose: see migration 12.
model TrashedDocument {
  id             String   @id @default(cuid())
  documentId     String   @unique
  slug           String
  title          String
  collectionId   String
  collectionName String
  deletedById    String?
  deletedByName  String?
  deletedAt      DateTime @default(now())
  snapshot       Json

  @@index([deletedAt])
  @@map("trashed_documents")
}

/// A named set of users (Tim CS, Koordinator Toko) that can be listed on a restricted collection or
/// document instead of each person: everyone in the group reads it, and a person added to or removed
/// from the group gains or loses access at once (migration 14).
model Group {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     GroupMember[]
  collections CollectionGroup[]
  documents   DocumentGroup[]

  @@map("groups")
}

model GroupMember {
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model CollectionGroup {
  collectionId String
  groupId      String
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([collectionId, groupId])
  @@index([groupId])
  @@map("collection_groups")
}

model DocumentGroup {
  documentId String
  groupId    String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([documentId, groupId])
  @@index([groupId])
  @@map("document_groups")
}
